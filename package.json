{
  "name": "pdv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*",
    "e2e"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present --workspace=packages/shared --workspace=apps/api --workspace=apps/pdv",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:studio": "prisma studio --schema apps/api/prisma/schema.prisma",
    "test:integracao": "npm run test:integracao --workspaces --if-present",
    "db:migrate:teste": "node scripts/migrar-banco.mjs DATABASE_URL_TESTE",
    "db:migrate:e2e": "node scripts/migrar-banco.mjs DATABASE_URL_E2E",
    "test:e2e": "npm run test -w @pdv/e2e"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.2": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.12.0": true,
    "prisma@6.12.0": true
  }
}
