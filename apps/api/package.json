{
  "name": "@pdv/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/servidor.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/servidor.js",
    "test": "vitest run --passWithNoTests --exclude \"**/*.integracao.test.ts\"",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "test:integracao": "vitest run --config vitest.integracao.config.ts",
    "seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "@fastify/jwt": "^10.2.2",
    "@pdv/shared": "*",
    "@prisma/client": "^6.1.0",
    "fastify": "^5.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "dotenv": "^16.6.1",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
