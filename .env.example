# =============================================================================
# PDV — variáveis de ambiente
#
# Copie para `.env` e preencha. O arquivo `.env` NUNCA vai para o git.
# Nenhum segredo pode existir dentro do código-fonte.
# =============================================================================

# --- Banco de dados ----------------------------------------------------------
POSTGRES_USER=pdv
# Obrigatória. Gere uma forte: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_DB=pdv
# 5433 de proposito: e comum a maquina ja ter um PostgreSQL instalado
# nativamente ocupando a 5432. Se as duas coisas escutarem na mesma porta, quem
# atende a conexao vira loteria e o sintoma e "authentication failed" aleatorio.
POSTGRES_PORT=5433

# String de conexão usada pelo Prisma ao rodar FORA do Docker (dev local).
# Dentro do Compose, a API monta a própria a partir das variáveis acima.
DATABASE_URL=postgresql://pdv:SENHA_AQUI@localhost:5433/pdv?schema=public

# Banco EXCLUSIVO dos testes de integracao. Eles fazem TRUNCATE em todas as
# tabelas a cada teste — apontar para o banco de desenvolvimento apagaria o
# catalogo e as vendas a cada `npm run test:integracao`.
DATABASE_URL_TESTE=postgresql://pdv:SENHA_AQUI@localhost:5433/pdv_teste?schema=public

# Banco EXCLUSIVO do Playwright (e2e/). Isolado do banco de testes de
# integracao da API para as duas suites poderem rodar em paralelo sem uma
# apagar o dado da outra.
DATABASE_URL_E2E=postgresql://pdv:SENHA_AQUI@localhost:5433/pdv_e2e?schema=public

# --- API ---------------------------------------------------------------------
API_PORTA=3333
# Obrigatória. Assina os tokens de sessão do operador.
# Gere: openssl rand -hex 32
JWT_SEGREDO=

# --- Frontend (PWA) ----------------------------------------------------------
# Endereço da API visto pelo navegador do caixa.
VITE_API_URL=http://localhost:3333

# --- Sincronização -----------------------------------------------------------
# Intervalo entre sincronizações do catálogo com o servidor, em minutos.
VITE_SYNC_INTERVALO_MINUTOS=10

# =============================================================================
# MÓDULO FISCAL — DESLIGADO NESTA VERSÃO
#
# O sistema imprime comprovante NÃO FISCAL. Nada abaixo é lido pelo código
# hoje; está documentado para quando a NFC-e for ligada. O certificado digital
# jamais deve ser commitado — aponte para um caminho fora do repositório.
# =============================================================================
FISCAL_HABILITADO=false
# FISCAL_CERTIFICADO_CAMINHO=
# FISCAL_CERTIFICADO_SENHA=
# FISCAL_UF=
# FISCAL_CNPJ=
# FISCAL_REGIME=
# FISCAL_AMBIENTE=homologacao
